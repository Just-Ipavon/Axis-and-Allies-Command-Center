# Port the backend listens on
PORT=1942
# Secret mixed into every password hash. Set a long random value and never change it
# afterwards (existing room passwords would stop working).
PEPPER_SECRET=change-me-to-a-long-random-string
# Optional password that unlocks banker/master actions in every room
ADMIN_OVERRIDE_PASSWORD=
# Comma-separated origins allowed to call the API cross-origin (the production
# frontend is served from the same origin and needs no entry here)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of reverse proxies in front of the server (used for rate limiting by client IP)
TRUST_PROXY_HOPS=1
